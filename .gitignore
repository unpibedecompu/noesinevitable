npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workers independientes (workers/*)
workers/*/node_modules
workers/*/.wrangler
